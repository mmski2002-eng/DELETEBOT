    lte r19 18446744073709551615u128 into r20;
    assert.eq r20 true;
    cast r19 into r21 as u64;
    cast r13 into r22 as u128;
    cast r21 into r23 as u128;
    add r22 r23 into r24;
    lte r24 18446744073709551615u128 into r25;
    assert.eq r25 true;
    add r13 r21 into r26;
    gte r2 r26 into r27;
    assert.eq r27 true;
    sub r2 r26 into r28;
    get.or_use flash_min_profit[r1] 0u64 into r29;
    gte r28 r29 into r30;
    assert.eq r30 true;
    get.or_use available_liquidity[r5] 0u64 into r31;
    cast r31 into r32 as u128;
    cast r2 into r33 as u128;
    add r32 r33 into r34;
    lte r34 18446744073709551615u128 into r35;
    assert.eq r35 true;
    add r31 r2 into r36;
    set r36 into available_liquidity[r5];
    get.or_use protocol_fees[r5] 0u64 into r37;
    cast r37 into r38 as u128;
    cast r21 into r39 as u128;
    add r38 r39 into r40;
    lte r40 18446744073709551615u128 into r41;
    assert.eq r41 true;
    add r37 r21 into r42;
    set r42 into protocol_fees[r5];
    set false into flash_active[r1];
    set 0u64 into flash_principal[r1];
    set 0u64 into flash_min_profit[r1];
    set 0field into flash_strategy_id[r1];

function flash_settle_with_usad:
    input r0 as test_usad_stablecoin.aleo/Token.record;
    input r1 as u64.private;
    input r2 as field.private;
    input r3 as [test_usad_stablecoin.aleo/MerkleProof; 2u32].private;
    gt r1 0u64 into r4;
    assert.eq r4 true;
    is.eq self.caller r0.owner into r5;
    assert.eq r5 true;
    hash.bhp256 self.caller into r6 as field;
    cast r1 into r7 as u128;
    call test_usad_stablecoin.aleo/transfer_private_to_public aleo1a2ehlgqhvs3p7d4hqhs0tvgk954dr8gafu9kxse2mzu9a5sqxvpsrn98pr r7 r0 r3 into r8 r9 r10;
    async flash_settle_with_usad r10 r6 r1 r2 into r11;
    output r8 as test_usad_stablecoin.aleo/ComplianceRecord.record;
    output r9 as test_usad_stablecoin.aleo/Token.record;
    output r11 as xyra_lending_v32.aleo/flash_settle_with_usad.future;

finalize flash_settle_with_usad:
    input r0 as test_usad_stablecoin.aleo/transfer_private_to_public.future;
    input r1 as field.public;
    input r2 as u64.public;
    input r3 as field.public;
    await r0;
    get.or_use flash_active[r1] false into r4;
    assert.eq r4 true;
    get.or_use flash_asset[r1] 0field into r5;
    is.eq r5 0field into r6;
    is.eq r5 1field into r7;
    or r6 r7 into r8;
    is.eq r5 2field into r9;
    or r8 r9 into r10;
    assert.eq r10 true;
    get.or_use flash_strategy_id[r1] 0field into r11;
    is.eq r11 r3 into r12;
    assert.eq r12 true;
    get.or_use flash_principal[r1] 0u64 into r13;
    get.or_use flash_premium_bps[r5] 5u64 into r14;
    cast r13 into r15 as u128;
    cast r14 into r16 as u128;
    mul r15 r16 into r17;
    add r17 9999u128 into r18;
    div r18 10000u128 into r19;
    lte r19 18446744073709551615u128 into r20;
    assert.eq r20 true;
    cast r19 into r21 as u64;
    cast r13 into r22 as u128;
    cast r21 into r23 as u128;
    add r22 r23 into r24;
    lte r24 18446744073709551615u128 into r25;
    assert.eq r25 true;
    add r13 r21 into r26;
    gte r2 r26 into r27;
    assert.eq r27 true;
    sub r2 r26 into r28;
    get.or_use flash_min_profit[r1] 0u64 into r29;
    gte r28 r29 into r30;
    assert.eq r30 true;
    get.or_use available_liquidity[r5] 0u64 into r31;
    cast r31 into r32 as u128;
    cast r2 into r33 as u128;
    add r32 r33 into r34;
    lte r34 18446744073709551615u128 into r35;
    assert.eq r35 true;
    add r31 r2 into r36;
    set r36 into available_liquidity[r5];
    get.or_use protocol_fees[r5] 0u64 into r37;
    cast r37 into r38 as u128;
    cast r21 into r39 as u128;
    add r38 r39 into r40;
    lte r40 18446744073709551615u128 into r41;
    assert.eq r41 true;
    add r37 r21 into r42;
    set r42 into protocol_fees[r5];
    set false into flash_active[r1];
    set 0u64 into flash_principal[r1];
    set 0u64 into flash_min_profit[r1];
    set 0field into flash_strategy_id[r1];

constructor:
    assert.eq program_owner aleo1rhgdu77hgyqd3xjj8ucu3jj9r2krwz6mnzyd80gncr5fxcwlh5rsvzp9px;
